# Flask Configuration
SECRET_KEY=yoursecretkeyhere_generate_a_random_one_for_production
FLASK_DEBUG=False
# Cho phép đăng nhập Google qua HTTP (mạng LAN không có HTTPS). Tắt đi nếu đã có HTTPS.
ALLOW_INSECURE_OAUTH=True
SESSION_COOKIE_SECURE=False

# Google OAuth Configuration (Thay đổi Client ID và Secret của bạn từ Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Email Notification Configuration (Gửi thông báo khi có tài khoản mới đăng ký)
NOTIFY_EMAIL=thuanan524@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_sender@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# SQL Server Database Configuration
DATABASE_URL=DRIVER={ODBC Driver 17 for SQL Server};SERVER=THUANAN\SQLEXPRESS;DATABASE=IC3ManagerMultiTenant;Trusted_Connection=yes;

# Google OAuth Local HTTP support
OAUTHLIB_INSECURE_TRANSPORT=1

# Gemini AI Configuration (Lấy key tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mật khẩu admin khi khởi tạo (để trống: sinh ngẫu nhiên và in ra một lần)
ADMIN_PASSWORD=
# (Tuỳ chọn) mật khẩu local cho admin đăng nhập Google; để trống = chỉ đăng nhập bằng Google
GOOGLE_ADMIN_PASSWORD=
# Dùng cho tests/run_tests.py
TEST_ADMIN_PASSWORD=
TEST_TEACHER_PASSWORD=

# Google Sheets API key (bảng điểm online)
GSHEET_API_KEY=
